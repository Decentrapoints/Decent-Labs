# No credentials in this example. Run pnpm run setup to create an owner.
DLS_HOST=127.0.0.1
DLS_PORT=4310
DLS_DATA_DIR=./data
DLS_COOKIE_SECURE=false
# When served through HTTPS, set the browser-facing origin and secure cookies.
# DLS_PUBLIC_ORIGIN=https://music.example.test
# Optional OpenAI-compatible LOCAL Satsu/LiteLLM route. Disabled when unset.
# SATSU_BASE_URL=http://localhost:11434/v1
# SATSU_MODEL=your-local-model
# SATSU_API_KEY=provision-locally
# REAPER bridge directory must match the folder selected in DLS_Satsu_Bridge.lua.
# DLS_BRIDGE_DIR=./bridge-runtime
